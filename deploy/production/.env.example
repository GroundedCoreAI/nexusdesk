# Copy to .env; replace all placeholders before deployment.
NEXUSDESK_VERSION=local
NEXUSDESK_BIND=127.0.0.1
NEXUSDESK_PORT=8080
AGENT_APP_NAME=NexusDesk
AGENT_TENANT_ID=local
AGENT_DATABASE_URL=postgresql+asyncpg://agent:REPLACE_ME@10.0.11.112:55433/agent_platform
AGENT_API_TOKEN=REPLACE_ME
AGENT_OPERATOR_API_TOKEN=REPLACE_OPERATOR_TOKEN
AGENT_VIEWER_API_TOKEN=REPLACE_VIEWER_TOKEN
AGENT_DATABASE_POOL_SIZE=5
AGENT_WORKER_CONCURRENCY=8
# Default off. Enable on selected Worker processes and restart to roll out the
# execution orchestrator; service-level environment entries override env_file.
AGENT_EXECUTION_ORCHESTRATOR_ENABLED=false
# Channel inbound/outbound loops run in the dedicated channel-worker container.
# Set true to embed them in the API instead (not recommended for production).
# AGENT_EMBEDDED_CHANNEL_WORKER=true
# Off by default. Set true to also load the 9 industry demo knowledge bases,
# 18 agents, and 36 documents (marked 【虚构案例资料】, fictional).
AGENT_SEED_INDUSTRIES=false
# Off by default. Set true to install and publish the four demo industry packs
# (shopping / gaming / creator / mobility) during the migrate step, so the console
# opens with four ready service applications instead of an empty list. Idempotent:
# a later deploy never republishes or overwrites operator edits. Requires a
# published Chat model profile before the conversations actually answer.
AGENT_SEED_INDUSTRY_PACKS=false
# Start without a default model; configure and publish Chat profiles in the UI.
AGENT_MODEL_BACKEND=unconfigured
# Optional legacy default model:
# AGENT_MODEL_BACKEND=openai
# AGENT_MODEL_NAME=your-model
# AGENT_MODEL_API_KEY=your-key
# AGENT_MODEL_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL_USE_RESPONSES_API=false
AGENT_MODEL_GATEWAY_ALLOWED_HOSTS=["api.openai.com","dgi.deepexi.com"]
# mock-business is the bundled demo upstream; it resolves to a private 172.x
# address, so the egress guard needs AGENT_TOOL_ALLOW_PRIVATE_NETWORKS as well.
# Drop both once tool sets point only at real, public business systems.
AGENT_TOOL_ALLOWED_HOSTS=["business-api.example.com","mock-business"]
AGENT_TOOL_ALLOW_PRIVATE_NETWORKS=true
# Remove/comment these optional services when using keyword-only retrieval without S3.
AGENT_MILVUS_URL=http://10.0.11.112:19530
AGENT_MILVUS_TOKEN=REPLACE_ME
AGENT_KNOWLEDGE_S3_ENDPOINT=http://10.0.11.112:19000
AGENT_KNOWLEDGE_S3_BUCKET=agent-knowledge
AGENT_KNOWLEDGE_S3_ACCESS_KEY=REPLACE_ME
AGENT_KNOWLEDGE_S3_SECRET_KEY=REPLACE_ME
# AGENT_KNOWLEDGE_PARSER_URL=http://parser:8090
# To use a mirror, override image arguments, e.g.:
# NEXUSDESK_BUILD_NETWORK=host # Only if the Docker host has disabled its default bridge
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.28-alpine

# Demo business upstream. It starts by default so a fresh deployment is usable
# before a real business system is wired up. Its in-network address is
# http://mock-business:8010 — that is what 配置管理 → 工具集 → 服务地址 uses.
# Remove the service (and the mock-business / private-network entries above)
# before going live: it authenticates nobody and can inject 5xx on demand.
# NEXUSDESK_MOCK_IMAGE=nexusdesk/mock-business-api:1.0.0
# MOCK_AUTH_TOKEN=
# MOCK_LATENCY_MS=0

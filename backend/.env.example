AGENT_APP_NAME=Agent Platform
AGENT_ENVIRONMENT=development
AGENT_DATABASE_URL=postgresql+asyncpg://agent:agent_dev@127.0.0.1:5432/agent_platform
# For any shared deployment, configure an API token and inject the trusted tenant server-side.
# AGENT_API_TOKEN=replace-me
AGENT_TENANT_ID=local
# Standalone memory-worker deployments MUST set this false in the worker
# container, or the R8 worker-heartbeat alert and its liveness record
# silently disable (embedded means "API alive implies worker alive").
AGENT_EMBEDDED_WORKER=true
# Set false to skip the forced first-login password change. Development only.
AGENT_REQUIRE_PASSWORD_CHANGE=true
# Off by default. Loads the full industry demo case set (9 knowledge bases,
# 18 agents, 36 documents) during container bootstrap.
# AGENT_SEED_INDUSTRIES=true
# Language of the seeded memory demo datasets, matching the console's i18n
# bundles: zh-CN (default), zh-TW, en, hi. Applied at first seed only
# (identities are created once).
# AGENT_SEED_LOCALE=zh-CN
AGENT_WORKER_CONCURRENCY=8
AGENT_QUEUE_CAPACITY=200
AGENT_TENANT_CAPACITY=50
AGENT_MAX_MODEL_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_RUN_TIMEOUT_SECONDS=90
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_TOOL_CONCURRENCY=8
AGENT_MODEL_BACKEND=demo
# Live model.delta SSE frames are enabled by default. Set false to disable streaming UI hints.
# AGENT_STREAM_MODEL_DELTAS=true
AGENT_TOOLS_FILE=examples/tools.demo.json
# Real model: set backend=openai and explicitly choose a tool-capable model.
# AGENT_MODEL_NAME=
# AGENT_MODEL_API_KEY=
# AGENT_MODEL_BASE_URL=
AGENT_MODEL_USE_RESPONSES_API=true

# Optional role tokens; configure distinct values. Admin is AGENT_API_TOKEN.
# AGENT_OPERATOR_API_TOKEN=replace-operator-token
# AGENT_VIEWER_API_TOKEN=replace-viewer-token
# Set ["*"] to allow any HTTP(S) tool host.
AGENT_TOOL_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# API-registered tool header secrets must reference AGENT_TOOL_SECRET_* variables.
# AGENT_TOOL_SECRET_CRM=replace-business-secret

# Model gateway (versioned online profiles; legacy default model above still works).
AGENT_MODEL_GATEWAY_ALLOWED_HOSTS=["localhost","127.0.0.1","api.openai.com"]
AGENT_MODEL_GATEWAY_CONCURRENCY=8
AGENT_MODEL_GATEWAY_MEDIA_BYTES=5000000
AGENT_MODEL_GATEWAY_RESPONSE_BYTES=10000000
# Inject AGENT_MODEL_SECRET_* into API/Worker process environments, not just this file.

# Document ingestion (separate knowledge Worker required).
# AGENT_KNOWLEDGE_PARSER_URL=http://127.0.0.1:8090
AGENT_KNOWLEDGE_UPLOAD_BYTES=20000000
AGENT_KNOWLEDGE_EXTRACTED_CHARS=2000000
# Optional external capability manifest directory. Manifest files are data-only;
# trusted implementations must be bound in the application composition root.
# AGENT_EXTERNAL_PLUGIN_DIRECTORY=plugins
# AGENT_EXTENSION_LIFECYCLE_TIMEOUT_SECONDS=30
# Optional original-file archive; configure credentials through deployment secrets.
# AGENT_KNOWLEDGE_S3_ENDPOINT=http://127.0.0.1:9000
# AGENT_KNOWLEDGE_S3_BUCKET=knowledge
# AGENT_KNOWLEDGE_S3_ACCESS_KEY=
# AGENT_KNOWLEDGE_S3_SECRET_KEY=
# AGENT_MILVUS_URL=http://127.0.0.1:19530
# AGENT_MILVUS_TOKEN=
# Memory production alerting (Phase 7); enabled by default with a 15-minute scan.
# AGENT_MEMORY_ALERT_ENABLED=true
# AGENT_MEMORY_ALERT_SCAN_INTERVAL_MINUTES=15
# AGENT_MEMORY_ALERT_COOLDOWN_MINUTES=60
# AGENT_MEMORY_ALERT_PENDING_TASK_MAX_AGE_MINUTES=60
# AGENT_MEMORY_ALERT_PENDING_BACKLOG_THRESHOLD=500
# AGENT_MEMORY_ALERT_VECTOR_FALLBACK_RATE=0.2
# Optional alert webhook; keep the URL in a secrets-managed env file if it embeds credentials.
# AGENT_MEMORY_ALERT_WEBHOOK_URL=
# AGENT_MEMORY_ALERT_WEBHOOK_TIMEOUT_SECONDS=5

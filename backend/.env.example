AGENT_APP_NAME=Agent Platform
AGENT_ENVIRONMENT=development
AGENT_DATABASE_URL=postgresql+asyncpg://agent:agent_dev@127.0.0.1:5432/agent_platform
# For any shared deployment, configure an API token and inject the trusted tenant server-side.
# AGENT_API_TOKEN=replace-me
AGENT_TENANT_ID=local
# Standalone memory-worker deployments MUST set this false in the worker
# container, or the R8 worker-heartbeat alert and its liveness record
# silently disable (embedded means "API alive implies worker alive").
AGENT_EMBEDDED_WORKER=true
# Knowledge must have a consumer in every deployment: the API embeds the loop
# when AGENT_EMBEDDED_WORKER=true, and production runs the knowledge-worker
# container. Set this false only if you deliberately removed knowledge support,
# so a missing consumer stays out of the checklist.
AGENT_KNOWLEDGE_WORKER_EXPECTED=true
# Forced first-login password change is disabled for local development.
AGENT_REQUIRE_PASSWORD_CHANGE=false
# Off by default. Loads the full industry demo case set (9 knowledge bases,
# 18 agents, 36 documents) during container bootstrap.
# AGENT_SEED_INDUSTRIES=true
# Language of the seeded memory demo datasets, matching the console's i18n
# bundles: zh-CN (default), zh-TW, en, hi. Applied at first seed only
# (identities are created once).
# AGENT_SEED_LOCALE=zh-CN

# Skill-centric service applications.
# Immutable code-owned examples are seeded when enabled; startup never updates
# an existing example or a user's copied application.
AGENT_SERVICE_APP_EXAMPLES_ENABLED=true
AGENT_SERVICE_APP_CONNECTION_TIMEOUT_SECONDS=10
AGENT_SERVICE_APP_CONNECTION_TIMEOUT_MAX=60
AGENT_SERVICE_APP_DEFAULT_PAGE_SIZE=10
# Draft previews are read-only/simulated by default.
AGENT_SERVICE_APP_PREVIEW_WRITE_ENABLED=false
# Optional separate vault for connection credentials. When empty, the
# installation-wide AGENT_MODEL_CREDENTIAL_KEY_FILE is reused.
# AGENT_SERVICE_APP_CREDENTIAL_KEY_FILE=data/credentials/service-apps.key
AGENT_WORKER_CONCURRENCY=8
AGENT_QUEUE_CAPACITY=200
AGENT_TENANT_CAPACITY=50
AGENT_MAX_MODEL_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_RUN_TIMEOUT_SECONDS=90
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_TOOL_CONCURRENCY=8
AGENT_MODEL_BACKEND=demo
# Live model.delta SSE frames are enabled by default. Set false to disable streaming UI hints.
# AGENT_STREAM_MODEL_DELTAS=true
AGENT_TOOLS_FILE=examples/tools.demo.json
# Real model: set backend=openai and explicitly choose a tool-capable model.
# AGENT_MODEL_NAME=
# AGENT_MODEL_API_KEY=
# AGENT_MODEL_BASE_URL=
AGENT_MODEL_USE_RESPONSES_API=true

# Optional role tokens; configure distinct values. Admin is AGENT_API_TOKEN.
# AGENT_OPERATOR_API_TOKEN=replace-operator-token
# AGENT_VIEWER_API_TOKEN=replace-viewer-token
# Set ["*"] to allow any HTTP(S) tool host.
AGENT_TOOL_ALLOWED_HOSTS=["127.0.0.1","localhost","::1"]
# Keep private/link-local tool destinations blocked by default. Enable only for
# explicitly allowlisted development or internal service hostnames.
AGENT_TOOL_ALLOW_PRIVATE_NETWORKS=false
# API-registered tool header secrets must reference AGENT_TOOL_SECRET_* variables.
# AGENT_TOOL_SECRET_CRM=replace-business-secret

# Model gateway (versioned online profiles; legacy default model above still works).
# Add the provider hosts this deployment actually uses. ["*"] disables the
# hostname check (opt-in for arbitrary providers, not recommended as a default).
AGENT_MODEL_GATEWAY_ALLOWED_HOSTS=["localhost","127.0.0.1","api.openai.com"]
AGENT_MODEL_GATEWAY_CONCURRENCY=8
AGENT_MODEL_GATEWAY_MEDIA_BYTES=5000000
AGENT_MODEL_GATEWAY_RESPONSE_BYTES=10000000
# Inject AGENT_MODEL_SECRET_* into API/Worker process environments, not just this file.

# Customer-service ingress routing decisions.
# Defaults to false; enable explicitly in the canary environment/process after
# migration and smoke tests. Unlike a pure kill switch, disabling this only
# stops decision-row writes and does not revert the human-request rule extension
# or the 409 reject contract.
# AGENT_CS_ROUTING_TRACE_ENABLED=true
# Optional JSON overrides. Rule ids and normalized phrases must be globally unique.
# AGENT_CS_ROUTING_HANDOFF_RULES=[{"id":"en_human_request_001","locale":"en","phrases":["human"]}]

# Document ingestion (separate knowledge Worker required).
# AGENT_KNOWLEDGE_PARSER_URL=http://127.0.0.1:8090
AGENT_KNOWLEDGE_UPLOAD_BYTES=20000000
AGENT_KNOWLEDGE_EXTRACTED_CHARS=2000000
# Optional external capability manifest directory. Manifest files are data-only;
# trusted implementations must be bound in the application composition root.
# AGENT_EXTERNAL_PLUGIN_DIRECTORY=plugins
# AGENT_EXTENSION_LIFECYCLE_TIMEOUT_SECONDS=30
# Optional original-file archive; configure credentials through deployment secrets.
# AGENT_KNOWLEDGE_S3_ENDPOINT=http://127.0.0.1:9000
# AGENT_KNOWLEDGE_S3_BUCKET=knowledge
# AGENT_KNOWLEDGE_S3_ACCESS_KEY=
# AGENT_KNOWLEDGE_S3_SECRET_KEY=
# Knowledge vector store backend. pgvector keeps vectors in the same PostgreSQL
# database as the documents (requires the pgvector extension on that server) and
# needs no extra service; milvus uses the two settings below. Changing this value
# requires re-publishing every vectorised library, because a snapshot's collection
# name only means something to the backend that created it.
# AGENT_KNOWLEDGE_VECTOR_BACKEND=pgvector
# Build a per-dimension HNSW index on first publication; false keeps exact scan.
# AGENT_KNOWLEDGE_PGVECTOR_HNSW=true
# AGENT_MILVUS_URL=http://127.0.0.1:19530
# AGENT_MILVUS_TOKEN=
# Memory production alerting (Phase 7); enabled by default with a 15-minute scan.
# AGENT_MEMORY_ALERT_ENABLED=true
# AGENT_MEMORY_ALERT_SCAN_INTERVAL_MINUTES=15
# AGENT_MEMORY_ALERT_COOLDOWN_MINUTES=60
# AGENT_MEMORY_ALERT_PENDING_TASK_MAX_AGE_MINUTES=60
# AGENT_MEMORY_ALERT_PENDING_BACKLOG_THRESHOLD=500
# AGENT_MEMORY_ALERT_VECTOR_FALLBACK_RATE=0.2
# Optional alert webhook; keep the URL in a secrets-managed env file if it embeds credentials.
# AGENT_MEMORY_ALERT_WEBHOOK_URL=
# AGENT_MEMORY_ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# Monitoring centre: one scanner owns every cadence and writes the checklist
# snapshot the console reads. Requests never probe dependencies.
# AGENT_MONITOR_ENABLED=true
# AGENT_MONITOR_FAST_INTERVAL_SECONDS=60
# AGENT_MONITOR_BUSINESS_INTERVAL_SECONDS=300
# AGENT_MONITOR_INTEGRATION_INTERVAL_SECONDS=300
# AGENT_MONITOR_MODEL_PROBE_INTERVAL_SECONDS=300
# AGENT_MONITOR_DAILY_INTERVAL_SECONDS=86400
# AGENT_MONITOR_STALE_AFTER_SECONDS=180
# Notification gating: a failing check must persist for N rounds before it
# raises a notification, and recover for N rounds before it closes.
# AGENT_MONITOR_P0_CONFIRM_ROUNDS=1
# AGENT_MONITOR_P1_CONFIRM_ROUNDS=2
# AGENT_MONITOR_P2_CONFIRM_ROUNDS=3
# AGENT_MONITOR_RECOVER_ROUNDS=3
# AGENT_MONITOR_REMINDER_MINUTES=120
# Thresholds (starting values, tune per deployment).
# AGENT_MONITOR_PG_LATENCY_WARN_MS=500
# AGENT_MONITOR_POOL_WARN_RATIO=0.8
# AGENT_MONITOR_POOL_FAIL_RATIO=0.95
# AGENT_MONITOR_CPU_WARN_RATIO=0.75
# AGENT_MONITOR_CPU_FAIL_RATIO=0.9
# AGENT_MONITOR_MEMORY_WARN_RATIO=0.75
# AGENT_MONITOR_MEMORY_FAIL_RATIO=0.9
# AGENT_MONITOR_QUEUE_WARN_AGE_SECONDS=300
# AGENT_MONITOR_QUEUE_FAIL_AGE_SECONDS=900
# AGENT_MONITOR_WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
# AGENT_MONITOR_PROBE_WARN_AGE_MINUTES=15
# AGENT_MONITOR_PROBE_FAIL_AGE_MINUTES=30
# AGENT_MONITOR_MODEL_SUCCESS_WARN_RATIO=0.95
# AGENT_MONITOR_MODEL_SUCCESS_FAIL_RATIO=0.8
# AGENT_MONITOR_MODEL_ERROR_WARN_RATIO=0.1
# AGENT_MONITOR_MODEL_LATENCY_WARN_RATIO=0.5
# AGENT_MONITOR_MODEL_LATENCY_FAIL_RATIO=1.0
# AGENT_MONITOR_QUOTA_WARN_RATIO=0.7
# AGENT_MONITOR_QUOTA_FAIL_RATIO=0.9
# AGENT_MONITOR_RUN_FAILURE_WARN_RATIO=0.05
# AGENT_MONITOR_RUN_FAILURE_FAIL_RATIO=0.1
# AGENT_MONITOR_TOOL_FAILURE_WARN_RATIO=0.02
# AGENT_MONITOR_TOOL_FAILURE_FAIL_RATIO=0.05
# AGENT_MONITOR_HANDOFF_WARN_AGE_SECONDS=900
# AGENT_MONITOR_HANDOFF_FAIL_AGE_SECONDS=1800
# Retention: closed notifications and scan history are pruned from inside the
# scanner loop. Active faults never expire.
# AGENT_MONITOR_PRUNE_INTERVAL_SECONDS=86400
# AGENT_MONITOR_NOTIFICATION_RETENTION_DAYS=90
# AGENT_MONITOR_SCAN_RETENTION_DAYS=7
